# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Resend
RESEND_API_KEY=your-resend-api-key

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared AI runtime (Credvia app)
AI_PROVIDER=groq
GROQ_API_KEY=your-fresh-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_MODEL=llama-3.3-70b
AI_PROVIDER_TIMEOUT_MS=30000
AI_WORKER_SECRET=replace-with-random-worker-secret
AI_WORKER_BATCH_SIZE=5
AI_WORKER_LEASE_SECONDS=45
AI_WORKER_MAX_RETRIES=3
AI_WORKER_TIMEOUT_MS=45000
AI_WORKER_BACKOFF_BASE_MS=2000
AI_WORKER_POLL_INTERVAL_MS=3000

# Optional feature flags
AI_FEATURE_FOUNDER_ENABLED=true
AI_FEATURE_CAREER_ENABLED=true
AI_FEATURE_MODERATION_ENABLED=true

# Legacy Groq env compatibility (fallback only, keep unset for new setups)
# AI_GROQ_API_KEY=
# GROQ_KEY=
# GROQ_TOKEN=
# LLM_API_KEY=

# Resume extractor service
RESUME_EXTRACTOR_URL=https://resume-extractor-5cgd.onrender.com
RESUME_EXTRACTOR_TIMEOUT_MS=60000
RESUME_EXTRACTOR_RETRY_COUNT=1
TRUSTED_SOURCE_CIDRS=74.220.48.0/24,74.220.56.0/24
ALLOWED_PROXY_CIDRS=74.220.48.0/24,74.220.56.0/24

# Resume extractor LLM + OCR
LLM_ALWAYS_ON=true
LLM_PROVIDER=groq
# Reuse GROQ_API_KEY from above or set a separate value in deployment secrets.
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=12
OCR_ENABLED=true
LOG_LEVEL=info
MAX_INPUT_SIZE_BYTES=10485760
MAX_LLM_TEXT_CHARS=12000
NEXT_PUBLIC_RESUME_EXTRACTOR_URL=http://localhost:8081
